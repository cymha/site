---
import Layout from '../layouts/Layout.astro'

const categories = [
  {
    id: 1,
    title: '情绪困扰',
    subtitle: '焦虑、抑郁、情绪波动',
    icon: 'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    symptoms: [
      '经常紧张、易惊、反复担心',
      '睡眠与食欲改变，常说"很累""不想上学"',
      '情绪低落、兴趣下降、易哭或易怒',
    ],
    effects: ['学习效率下降，自信受挫', '家庭冲突增加，社交退缩'],
  },
  {
    id: 2,
    title: '行为困扰',
    subtitle: '冲动、对抗、规则困难',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    symptoms: [
      '情绪爆发、摔物、顶嘴、挑衅或拒绝配合',
      '难以遵守规则，延迟满足困难',
      '学校纪律问题或师生冲突反复出现',
    ],
    effects: ['亲子关系紧绷', '校园适应困难与负面标签化'],
  },
  {
    id: 3,
    title: '社交与人际困扰',
    subtitle: '社交退缩、同伴冲突、欺凌相关',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
    symptoms: [
      '害怕与同伴互动，担心被评价',
      '人际误会频繁，难以维持友谊',
      '遭遇排斥或欺凌后出现回避与警觉',
    ],
    effects: ['孤立感上升，自我认同受影响', '焦虑与情绪困扰加重'],
  },
  {
    id: 4,
    title: '学习与压力相关困扰',
    subtitle: '厌学、考试焦虑、完美主义压力',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
    symptoms: [
      '对考试或上学强烈恐惧，逃避学习',
      '注意力不集中、拖延、作息混乱',
      '过度自责或追求完美，压力难以缓解',
    ],
    effects: ['压力循环持续，情绪与自尊受损', '家庭沟通恶化，亲子冲突增加'],
  },
  {
    id: 5,
    title: '适应与创伤相关困扰',
    subtitle: '环境变化、家庭变故、疫情后适应等',
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    symptoms: [
      '明显退缩或情绪爆发',
      '安全感下降，对未来迷茫',
      '对变化高度敏感、容易受惊或反复回想',
    ],
    effects: ['适应时间拉长，影响家庭与校园生活质量'],
  },
]
---

<Layout
  title="儿童心理服务"
  description="了解儿童与青少年常见心理困扰的类别与具体表现，及早发现、及早改善、精准介入"
>
  <!-- Hero -->
  <section class="bg-primary-light py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <span
        class="text-primary text-sm font-semibold tracking-wider uppercase mb-3 block"
        >服务</span
      >
      <h1 class="text-3xl md:text-4xl font-bold text-text mb-4">
        儿童与青少年常见心理困扰
      </h1>
      <p class="text-text-light text-lg max-w-2xl leading-relaxed">
        孩子的情绪与行为问题，常常是压力、发展阶段、家庭互动与学校环境等多重因素共同作用的结果。及早理解与辨识常见困扰，有助于家庭与学校在适当时机提供支持，减少问题恶化，并提升复原力。
      </p>
      <div
        class="mt-6 inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-xl font-semibold text-sm"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        及早发现、及早改善、精准介入
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="space-y-8">
        {
          categories.map((cat) => (
            <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-4 mb-6">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                  <svg
                    class="w-6 h-6 text-primary"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={cat.icon}
                    />
                  </svg>
                </div>
                <div>
                  <span class="text-primary text-xs font-semibold tracking-wider uppercase">
                    类别 {cat.id}
                  </span>
                  <h2 class="text-xl font-bold text-text mt-1">{cat.title}</h2>
                  <p class="text-text-muted text-sm">{cat.subtitle}</p>
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-6">
                <div class="bg-secondary/50 rounded-xl p-5">
                  <h3 class="font-semibold text-text text-sm mb-3 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-amber-400" />
                    可能表现
                  </h3>
                  <ul class="space-y-2">
                    {cat.symptoms.map((s) => (
                      <li class="text-sm text-text-light flex items-start gap-2">
                        <span class="text-primary mt-1 shrink-0">-</span>
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="bg-red-50 rounded-xl p-5">
                  <h3 class="font-semibold text-text text-sm mb-3 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-red-400" />
                    可能影响
                  </h3>
                  <ul class="space-y-2">
                    {cat.effects.map((e) => (
                      <li class="text-sm text-text-light flex items-start gap-2">
                        <span class="text-red-400 mt-1 shrink-0">-</span>
                        <span>{e}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- When to Seek Help -->
  <section class="py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div
        class="w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center mx-auto mb-6"
      >
        <svg
          class="w-8 h-8 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        何时建议寻求专业协助
      </h2>
      <p class="text-white/80 leading-relaxed max-w-2xl mx-auto">
        当困扰持续一段时间并影响到上学、睡眠、饮食、人际或家庭关系，或家长与老师已难以自行处理时，建议尽早进行专业评估与咨询，以厘清核心原因并制定合适的介入方向。
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-text mb-8">立即行动</h2>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/team"
          class="px-8 py-4 bg-primary text-white rounded-xl font-medium hover:bg-primary-dark transition-colors shadow-lg shadow-primary/20"
        >
          立即预约心理评估
        </a>
        <a
          href="/services"
          class="px-8 py-4 bg-white text-primary border-2 border-primary/20 rounded-xl font-medium hover:bg-primary-light transition-colors"
        >
          了解辅导与治疗服务
        </a>
        <a
          href="/exam"
          class="px-8 py-4 bg-secondary text-text rounded-xl font-medium hover:bg-gray-200 transition-colors"
        >
          查询亲子讲座与工作坊
        </a>
      </div>
    </div>
  </section>
</Layout>
