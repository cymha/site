---
import Layout from '../layouts/Layout.astro'

const qualifications = [
  '华南师范大学心理学博士生',
  '美国游戏治疗协会注册游戏治疗师',
  '美国心理学会会员',
  '香港注册社工',
  '香港中文大学社会科学硕士',
]

const experiences = [
  '超过十年儿童、青少年心理领域工作经验',
  '曾为超过 5000 个儿童、青少年及其家庭提供专业服务',
  '曾担任武汉、深圳等多家机构督导',
  '曾参与香港理工大学、香港教育大学、华南师范大学等多所高校的儿童心理研究项目',
]
---

<Layout title="专业团队" description="认识我们的心理学专业团队与顾问">
  <!-- Hero -->
  <section class="bg-primary-light py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <span
        class="text-primary text-sm font-semibold tracking-wider uppercase mb-3 block"
        >团队</span
      >
      <h1 class="text-3xl md:text-4xl font-bold text-text mb-4">
        专业团队与顾问
      </h1>
      <p class="text-text-light text-lg max-w-2xl leading-relaxed">
        我们重视以专业伦理与实证基础为核心，并以跨学术与实践的视角，为儿童、青少年及家庭提供更合适的心理评估与心理辅导服务。同时，我们也为教育工作者与相关专业人士提供系统化培训与督导支持。
      </p>
    </div>
  </section>

  <!-- Chief Consultant -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <div class="bg-white border border-gray-100 rounded-3xl overflow-hidden">
        <div class="bg-primary p-8 md:p-12 text-center">
          <div
            class="w-24 h-24 rounded-full bg-white/20 flex items-center justify-center mx-auto mb-6 ring-4 ring-white/10"
          >
            <svg
              class="w-12 h-12 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
          </div>
          <span
            class="inline-block px-3 py-1 bg-white/20 rounded-full text-white/90 text-xs font-medium mb-3"
            >首席顾问</span
          >
          <h2 class="text-3xl font-bold text-white mb-2">金天天</h2>
          <p class="text-white/70">
            注册游戏治疗师 · 香港注册社工 · 心理学博士生
          </p>
        </div>

        <div class="p-8 md:p-12">
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-semibold text-text mb-4 flex items-center gap-2">
                <svg
                  class="w-5 h-5 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                  ></path>
                </svg>
                专业资质
              </h3>
              <ul class="space-y-3">
                {
                  qualifications.map((q) => (
                    <li class="flex items-start gap-3">
                      <span class="w-1.5 h-1.5 rounded-full bg-primary mt-2 shrink-0" />
                      <span class="text-text-light text-sm">{q}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div>
              <h3 class="font-semibold text-text mb-4 flex items-center gap-2">
                <svg
                  class="w-5 h-5 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
                工作经验
              </h3>
              <ul class="space-y-3">
                {
                  experiences.map((e) => (
                    <li class="flex items-start gap-3">
                      <span class="w-1.5 h-1.5 rounded-full bg-accent mt-2 shrink-0" />
                      <span class="text-text-light text-sm">{e}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <div class="mt-10 pt-8 border-t border-gray-100">
            <div class="flex items-center justify-center gap-8 text-center">
              <div>
                <div class="text-3xl font-bold text-primary">10+</div>
                <div class="text-xs text-text-muted mt-1">年专业经验</div>
              </div>
              <div class="w-px h-12 bg-gray-200"></div>
              <div>
                <div class="text-3xl font-bold text-primary">5000+</div>
                <div class="text-xs text-text-muted mt-1">服务个案</div>
              </div>
              <div class="w-px h-12 bg-gray-200"></div>
              <div>
                <div class="text-3xl font-bold text-primary">多间</div>
                <div class="text-xs text-text-muted mt-1">高校研究参与</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-secondary">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-text mb-8">与我们取得联系</h2>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/services"
          class="px-8 py-4 bg-primary text-white rounded-xl font-medium hover:bg-primary-dark transition-colors shadow-lg shadow-primary/20"
        >
          联系我们了解服务
        </a>
        <a
          href="/exam"
          class="px-8 py-4 bg-white text-text border border-gray-200 rounded-xl font-medium hover:bg-gray-50 transition-colors"
        >
          查询专业培训与督导
        </a>
      </div>
    </div>
  </section>
</Layout>
