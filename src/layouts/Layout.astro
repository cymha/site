---
import { getRelativeLocaleUrl } from 'astro:i18n'
import LangSwitcher from '../components/LangSwitcher.astro'
import { defaultLocale, locales, type Locale, t } from '../i18n'
import '../styles/global.css'

export interface Props {
  lang: Locale
  title: string
  description?: string
}

const { lang, title, description } = Astro.props

const tr = t(lang)
const meta = tr.meta
const nav = tr.nav

const navItems = [
  { href: getRelativeLocaleUrl(lang, '/'), label: nav.home },
  { href: getRelativeLocaleUrl(lang, '/services'), label: nav.services },
  { href: getRelativeLocaleUrl(lang, '/president'), label: nav.president },
  { href: getRelativeLocaleUrl(lang, '/exam'), label: nav.exam },
]

const path = Astro.url.pathname
const normalizedNav = navItems.map((item) => ({
  ...item,
  isActive:
    item.href === '/'
      ? path === '/'
      : path === item.href || path === item.href.replace(/\/$/, ''),
}))
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — {meta.titleSuffix}</title>
    <meta name="description" content={description ?? meta.siteDescription} />
    <link rel="icon" href="/logo.webp" />
    <script is:inline define:vars={{ lang, path, locales, defaultLocale }}>
      function toTarget(target, originalPath) {
        let stripped = originalPath
        for (const locale of locales) {
          if (originalPath.startsWith(`/${locale}`)) {
            stripped = originalPath.replace(`/${locale}`, '')
            break
          }
        }

        if (stripped === '/' || stripped === '') {
          return target === defaultLocale ? '/' : `/${target}`
        }
        return `/${target}${stripped}`
      }

      let preferred = localStorage.getItem('cymha:lang')
      if (preferred === null) {
        for (const raw of navigator.languages) {
          const tag = raw.toLowerCase()
          if (tag.startsWith('en')) {
            preferred = 'en'
            break
          }
          if (
            tag.startsWith('zh-hans') ||
            tag === 'zh-cn' ||
            tag === 'zh-sg' ||
            tag === 'zh-my'
          ) {
            preferred = 'zh-cn'
            break
          }
          if (tag.startsWith('zh')) {
            preferred = 'zh-hk'
          }
        }
      }

      if (preferred !== null && preferred !== lang) {
        location.replace(toTarget(preferred, path))
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-white">
    <!-- Header -->
    <header
      class="border-primary-light sticky top-0 z-50 border-b bg-white/90 backdrop-blur-md"
    >
      <div
        class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6"
      >
        <a
          href={getRelativeLocaleUrl(lang, '/')}
          class="group flex items-center gap-3"
        >
          <img
            src="/logo.webp"
            alt={meta.siteName}
            class="h-9 w-auto rounded-lg object-contain"
          />
          <span
            class="text-text hidden text-sm font-semibold tracking-wide sm:block"
            >{meta.siteName}</span
          >
        </a>

        <div class="flex items-center gap-1">
          <nav class="flex items-center gap-1">
            {
              normalizedNav.map((item) => (
                <a
                  href={item.href}
                  class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors sm:px-4 ${
                    item.isActive
                      ? 'bg-primary text-white'
                      : 'text-text-light hover:text-primary hover:bg-primary-light'
                  }`}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <LangSwitcher lang={lang} currentPath={path} />
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-text text-white/80">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="mb-8 grid gap-8 md:grid-cols-3">
          <div>
            <div class="mb-4 flex items-center gap-2">
              <img
                src="/logo.webp"
                alt={meta.siteName}
                class="h-8 w-auto rounded-lg object-contain"
              />
              <span class="font-semibold text-white">{meta.siteName}</span>
            </div>
            <p class="text-sm leading-relaxed text-white/60">
              {tr.footer.aboutBlurb}
            </p>
          </div>

          <div>
            <h4 class="mb-4 font-semibold text-white">
              {tr.footer.quickLinks}
            </h4>
            <ul class="space-y-2 text-sm">
              {
                navItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-white/60 transition-colors hover:text-white"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h4 class="mb-4 font-semibold text-white">{tr.footer.contact}</h4>
            <p class="text-sm leading-relaxed text-white/60 mb-4">
              {tr.footer.contactBlurb}
            </p>
            <div class="space-y-3 text-sm text-white/60">
              <div class="flex items-start gap-2">
                <svg
                  class="mt-0.5 h-4 w-4 shrink-0 text-white/50"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  />
                </svg>
                <a
                  href="tel:+85246804794"
                  class="hover:text-white transition-colors"
                >
                  {tr.footer.contactPhone}
                </a>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="mt-0.5 h-4 w-4 shrink-0 text-white/50"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
                <a
                  href="mailto:info@cymha.org"
                  class="hover:text-white transition-colors"
                >
                  {tr.footer.contactEmail}
                </a>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="mt-0.5 h-4 w-4 shrink-0 text-white/50"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <div>
                  <p class="font-medium text-white/80 mb-1">
                    {tr.footer.contactHoursHeading}
                  </p>
                  {tr.footer.contactHours.map((line) => (
                    <p class="leading-relaxed">{line}</p>
                  ))}
                </div>
              </div>
              <div class="flex items-start gap-2">
                <svg
                  class="mt-0.5 h-4 w-4 shrink-0 text-white/50"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                <p class="leading-relaxed">{tr.footer.contactAddress}</p>
              </div>
            </div>
          </div>
        </div>

        <div
          class="border-t border-white/10 pt-8 text-center text-xs text-white/40"
        >
          © {new Date().getFullYear()}
          {meta.siteName}. {tr.footer.rights}
        </div>
      </div>
    </footer>
  </body>
</html>
