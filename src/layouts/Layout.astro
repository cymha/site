---
import '../styles/global.css'

export interface Props {
  title: string
  description?: string
}

const {
  title,
  description = '香港儿童青年心理健康协会 — 连接学术与实践的心理专业平台',
} = Astro.props

const navItems = [
  { href: '/', label: '首页' },
  { href: '/services', label: '服务' },
  { href: '/team', label: '团队' },
  { href: '/exam', label: '考试报名' },
]

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="zh-HK">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} — 香港儿童青年心理健康协会</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white min-h-screen flex flex-col">
    <!-- Header -->
    <header
      class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-primary-light"
    >
      <div
        class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between"
      >
        <a href="/" class="flex items-center gap-3 group">
          <div
            class="w-9 h-9 rounded-lg bg-primary flex items-center justify-center"
          >
            <svg
              class="w-5 h-5 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path>
            </svg>
          </div>
          <span
            class="font-semibold text-text text-sm tracking-wide hidden sm:block"
            >香港儿童青年心理健康协会</span
          >
        </a>

        <nav class="flex items-center gap-1">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
                  currentPath === item.href
                    ? 'bg-primary text-white'
                    : 'text-text-light hover:text-primary hover:bg-primary-light'
                }`}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-text text-white/80">
      <div class="max-w-6xl mx-auto px-6 py-12">
        <div class="grid md:grid-cols-3 gap-8 mb-8">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <div
                class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  ></path>
                </svg>
              </div>
              <span class="font-semibold text-white"
                >香港儿童青年心理健康协会</span
              >
            </div>
            <p class="text-sm leading-relaxed text-white/60">
              连接学术与实践的心理专业平台，整合社会资源，全面促进儿童及青年的心理健康。
            </p>
          </div>

          <div>
            <h4 class="font-semibold text-white mb-4">快速链接</h4>
            <ul class="space-y-2 text-sm">
              {
                navItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-white/60 hover:text-white transition-colors"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-white mb-4">联系我们</h4>
            <p class="text-sm text-white/60 leading-relaxed">
              如需咨询或预约服务，欢迎与我们取得联系。
            </p>
          </div>
        </div>

        <div
          class="border-t border-white/10 pt-8 text-center text-xs text-white/40"
        >
          © {new Date().getFullYear()} 香港儿童青年心理健康协会. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
