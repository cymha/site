---
import '../styles/global.css'
import { getRelativeLocaleUrl } from 'astro:i18n'
import LangSwitcher from '../components/LangSwitcher.astro'
import { type Locale, t } from '../i18n'
import i18n from '../i18n?url'

export interface Props {
  lang: Locale
  title: string
  description?: string
}

const { lang, title, description } = Astro.props

const tr = t(lang)
const meta = tr.meta
const nav = tr.nav

const navItems = [
  { href: getRelativeLocaleUrl(lang, '/'), label: nav.home },
  { href: getRelativeLocaleUrl(lang, '/services'), label: nav.services },
  { href: getRelativeLocaleUrl(lang, '/exam'), label: nav.exam },
]

const path = Astro.url.pathname
const normalizedNav = navItems.map((item) => ({
  ...item,
  isActive:
    item.href === '/'
      ? path === '/'
      : path === item.href || path === item.href.replace(/\/$/, ''),
}))
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? meta.siteDescription} />
    <title>{title} — {meta.titleSuffix}</title>
    <script is:inline type="module" define:vars={{ i18n, lang, path }}>
      const { toTarget } = await import(i18n)

      let preferred = localStorage.getItem('cymha:lang')
      if (preferred === null) {
        for (const raw of navigator.languages) {
          const tag = raw.toLowerCase()
          if (tag.startsWith('en')) {
            preferred = 'en'
            break
          }
          if (
            tag.startsWith('zh-hans') ||
            tag === 'zh-cn' ||
            tag === 'zh-sg' ||
            tag === 'zh-my'
          ) {
            preferred = 'zh-cn'
            break
          }
          if (tag.startsWith('zh')) {
            preferred = 'zh-hk'
          }
        }
      }

      if (preferred !== null && preferred !== lang) {
        location.replace(toTarget(preferred, path))
      }
    </script>
  </head>
  <body class="bg-white min-h-screen flex flex-col">
    <!-- Header -->
    <header
      class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-primary-light"
    >
      <div
        class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-4"
      >
        <a
          href={getRelativeLocaleUrl(lang, '/')}
          class="flex items-center gap-3 group"
        >
          <div
            class="w-9 h-9 rounded-lg bg-primary flex items-center justify-center shrink-0"
          >
            <svg
              class="w-5 h-5 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path>
            </svg>
          </div>
          <span
            class="font-semibold text-text text-sm tracking-wide hidden sm:block"
            >{meta.siteName}</span
          >
        </a>

        <div class="flex items-center gap-1">
          <nav class="flex items-center gap-1">
            {
              normalizedNav.map((item) => (
                <a
                  href={item.href}
                  class={`px-3 sm:px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
                    item.isActive
                      ? 'bg-primary text-white'
                      : 'text-text-light hover:text-primary hover:bg-primary-light'
                  }`}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <LangSwitcher lang={lang} currentPath={path} />
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-text text-white/80">
      <div class="max-w-6xl mx-auto px-6 py-12">
        <div class="grid md:grid-cols-3 gap-8 mb-8">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <div
                class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center"
              >
                <svg
                  class="w-4 h-4 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  ></path>
                </svg>
              </div>
              <span class="font-semibold text-white">{meta.siteName}</span>
            </div>
            <p class="text-sm leading-relaxed text-white/60">
              {tr.footer.aboutBlurb}
            </p>
          </div>

          <div>
            <h4 class="font-semibold text-white mb-4">
              {tr.footer.quickLinks}
            </h4>
            <ul class="space-y-2 text-sm">
              {
                navItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-white/60 hover:text-white transition-colors"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-white mb-4">{tr.footer.contact}</h4>
            <p class="text-sm text-white/60 leading-relaxed">
              {tr.footer.contactBlurb}
            </p>
          </div>
        </div>

        <div
          class="border-t border-white/10 pt-8 text-center text-xs text-white/40"
        >
          © {new Date().getFullYear()}
          {meta.siteName}. {tr.footer.rights}
        </div>
      </div>
    </footer>
  </body>
</html>
