---
import { type Locale, t } from '../../i18n'
import Layout from '../../layouts/Layout.astro'

export interface Props {
  lang: Locale
}

const { lang } = Astro.props
const tr = t(lang).exam
---

<Layout lang={lang} title={tr.title} description={tr.description}>
  <!-- Hero -->
  <section class="bg-primary-light py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <span
        class="text-primary mb-3 block text-sm font-semibold tracking-wider uppercase"
        >{tr.eyebrow}</span
      >
      <h1 class="text-text mb-4 text-3xl font-bold md:text-4xl">
        {tr.heading}
      </h1>
      <p class="text-text-light max-w-2xl text-lg leading-relaxed">
        {tr.intro}
      </p>
    </div>
  </section>

  <!-- Exam Info -->
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-text mb-8 text-2xl font-bold">{tr.infoTitle}</h2>
      <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white">
        {
          tr.examInfo.map((item, i) => (
            <div
              class={`flex flex-col px-6 py-4 sm:flex-row sm:items-center ${i !== tr.examInfo.length - 1 ? 'border-b border-gray-50' : ''}`}
            >
              <div class="mb-1 shrink-0 sm:mb-0 sm:w-40">
                <span class="text-text text-sm font-semibold">
                  {item.label}
                </span>
              </div>
              <span
                class={`text-sm ${item.placeholder ? 'text-text-muted' : 'text-text-light'}`}
              >
                {item.value}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="bg-secondary py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-text mb-10 text-center text-2xl font-bold">
        {tr.stepsTitle}
      </h2>
      <div class="relative">
        <div
          class="bg-primary/20 absolute top-0 bottom-0 left-6 hidden w-0.5 sm:block"
        >
        </div>

        <div class="space-y-6">
          {
            tr.steps.map((step, i) => (
              <div class="flex items-start gap-4 sm:gap-6">
                <div class="bg-primary z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white">
                  {i + 1}
                </div>
                <div class="flex-1 rounded-xl bg-white p-5 shadow-sm">
                  <p class="text-text-light">{step}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-text mb-10 text-center text-2xl font-bold">
        {tr.faqTitle}
      </h2>
      <div class="space-y-4">
        {
          tr.faqs.map((faq) => (
            <div class="rounded-2xl border border-gray-100 bg-white p-6">
              <h3 class="text-text mb-3 flex items-start gap-3 font-semibold">
                <span class="text-primary shrink-0 font-bold">Q</span>
                <span>{faq.question}</span>
              </h3>
              <p
                class={`pl-7 text-sm leading-relaxed ${faq.placeholder ? 'text-text-muted' : 'text-text-light'}`}
              >
                {faq.answer}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="mb-8 text-2xl font-bold text-white">{tr.ctaTitle}</h2>
      <div class="flex flex-wrap justify-center gap-4">
        <button
          class="text-primary rounded-xl bg-white px-8 py-4 font-medium transition-colors hover:bg-gray-100"
        >
          {tr.ctaApply}
        </button>
        <button
          class="rounded-xl border border-white/20 bg-white/10 px-8 py-4 font-medium text-white transition-colors hover:bg-white/20"
        >
          {tr.ctaEligibility}
        </button>
        <button
          class="rounded-xl border border-white/20 bg-white/10 px-8 py-4 font-medium text-white transition-colors hover:bg-white/20"
        >
          {tr.ctaDetails}
        </button>
      </div>
    </div>
  </section>
</Layout>
