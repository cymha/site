---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import trainingProgram from '../../assets/专业培训课程.webp'
import academicExchange from '../../assets/学术交流合作.webp'
import mentalHealthService from '../../assets/心理健康服务.webp'
import workshops from '../../assets/讲座及工作坊.webp'
import { type Locale, t } from '../../i18n'
import Layout from '../../layouts/Layout.astro'

export interface Props {
  lang: Locale
}

const { lang } = Astro.props
const tr = t(lang).home
const cardImages = [
  mentalHealthService,
  trainingProgram,
  workshops,
  academicExchange,
]
---

<Layout lang={lang} title={tr.title}>
  <!-- Hero Section -->
  <section class="bg-primary-light relative overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <svg
        class="h-full w-full"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
      >
        <defs>
          <pattern
            id="dots"
            x="0"
            y="0"
            width="20"
            height="20"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="2" cy="2" r="1" fill="#2a7a6e" opacity="0.15"></circle>
          </pattern>
        </defs>
        <rect width="100" height="100" fill="url(#dots)"></rect>
      </svg>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32">
      <div class="max-w-2xl">
        <div
          class="border-primary/10 text-primary mb-6 inline-flex items-center gap-2 rounded-full border bg-white/80 px-3 py-1.5 text-xs font-medium"
        >
          <span class="bg-primary h-1.5 w-1.5 animate-pulse rounded-full"
          ></span>
          {tr.heroBadge}
        </div>
        <h1 class="text-text mb-6 text-4xl leading-tight font-bold md:text-5xl">
          {tr.heroTitleLine1}<br />{tr.heroTitleLine2}
        </h1>
        <p class="text-text-light mb-8 max-w-xl text-lg leading-relaxed">
          {tr.heroDescription}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={getRelativeLocaleUrl(lang, '/services')}
            class="bg-primary hover:bg-primary-dark shadow-primary/20 rounded-xl px-6 py-3 text-sm font-medium text-white shadow-lg transition-colors"
          >
            {tr.ctaServices}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid items-start gap-12 md:grid-cols-2">
        <div>
          <span
            class="text-primary mb-3 block text-sm font-semibold tracking-wider uppercase"
            >{tr.aboutEyebrow}</span
          >
          <h2 class="text-text mb-6 text-3xl font-bold">{tr.aboutTitle}</h2>
          <div class="text-text-light space-y-4 leading-relaxed">
            <p>{tr.aboutP1}</p>
            <p>{tr.aboutP2}</p>
            <p>{tr.aboutP3}</p>
          </div>
        </div>

        <div class="space-y-6">
          <!-- Mission Card -->
          <div class="bg-secondary rounded-2xl p-8">
            <div
              class="bg-primary/10 mb-4 flex h-10 w-10 items-center justify-center rounded-xl"
            >
              <svg
                class="text-primary h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-text mb-3 text-lg font-semibold">
              {tr.missionTitle}
            </h3>
            <ul class="text-text-light space-y-2 text-sm">
              {
                tr.missionItems.map((m) => (
                  <li class="flex items-start gap-2">
                    <span class="bg-primary mt-2 h-1 w-1 shrink-0 rounded-full" />
                    <span>{m}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Values Card -->
          <div class="bg-primary-light rounded-2xl p-8">
            <div
              class="bg-primary/10 mb-4 flex h-10 w-10 items-center justify-center rounded-xl"
            >
              <svg
                class="text-primary h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-text mb-4 text-lg font-semibold">
              {tr.valuesTitle}
            </h3>
            <div class="grid grid-cols-2 gap-3">
              {
                tr.values.map((v) => (
                  <div class="rounded-xl bg-white p-4 text-center">
                    <div class="text-primary mb-1 text-sm font-semibold">
                      {v.name}
                    </div>
                    <div class="text-text-muted text-xs">{v.desc}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="bg-secondary py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-14 text-center">
        <span
          class="text-primary mb-3 block text-sm font-semibold tracking-wider uppercase"
          >{tr.servicesEyebrow}</span
        >
        <h2 class="text-text text-3xl font-bold">{tr.servicesTitle}</h2>
      </div>

      <div class="mb-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          tr.servicesCards.map((card, i) => {
            const icons = [
              'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
              'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
              'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
              'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
            ]
            return (
              <div class="rounded-2xl bg-white p-6 transition-shadow hover:shadow-lg">
                <Image
                  src={cardImages[i]!}
                  alt={card.title}
                  class="mb-4 h-36 w-full rounded-xl object-cover"
                />
                <div class="bg-primary/10 mb-4 flex h-12 w-12 items-center justify-center rounded-xl">
                  <svg
                    class="text-primary h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={icons[i]}
                    />
                  </svg>
                </div>
                <h3 class="text-text mb-2 font-semibold">{card.title}</h3>
                <p class="text-text-muted text-sm leading-relaxed">
                  {card.desc}
                </p>
              </div>
            )
          })
        }
      </div>

      <div class="flex flex-wrap justify-center gap-3">
        <a
          href={getRelativeLocaleUrl(lang, '/services')}
          class="bg-primary hover:bg-primary-dark rounded-xl px-6 py-3 text-sm font-medium text-white transition-colors"
        >
          {tr.ctaLearnServices}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, '/exam')}
          class="text-text rounded-xl border border-gray-200 bg-white px-6 py-3 text-sm font-medium transition-colors hover:bg-gray-50"
        >
          {tr.ctaInquireTraining}
        </a>
      </div>
    </div>
  </section>

  <!-- Target Audience -->
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <span
        class="text-primary mb-3 block text-sm font-semibold tracking-wider uppercase"
        >{tr.audienceEyebrow}</span
      >
      <h2 class="text-text mb-8 text-3xl font-bold">{tr.audienceTitle}</h2>
      <div class="flex flex-wrap justify-center gap-4">
        {
          tr.audienceTags.map((tag) => (
            <div class="bg-primary-light text-primary rounded-full px-6 py-3 text-sm font-medium">
              {tag}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
