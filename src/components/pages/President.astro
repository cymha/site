---
import { getRelativeLocaleUrl } from 'astro:i18n'
import Layout from '../../layouts/Layout.astro'
import { type Locale, t } from '../../i18n'

export interface Props {
  lang: Locale
}

const { lang } = Astro.props
const tr = t(lang).president
---

<Layout lang={lang} title={tr.title} description={tr.description}>
  <!-- Hero -->
  <section class="relative bg-primary-light overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <svg
        class="w-full h-full"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
      >
        <defs>
          <pattern
            id="dots"
            x="0"
            y="0"
            width="20"
            height="20"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="2" cy="2" r="1" fill="#2a7a6e" opacity="0.15"></circle>
          </pattern>
        </defs>
        <rect width="100" height="100" fill="url(#dots)"></rect>
      </svg>
    </div>
    <div class="relative max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="max-w-2xl">
        <span
          class="text-primary text-sm font-semibold tracking-wider uppercase mb-3 block"
          >{tr.eyebrow}</span
        >
        <h1
          class="text-3xl md:text-5xl font-bold text-text leading-tight mb-6"
        >
          {tr.heading}
        </h1>
        <p class="text-text-light text-lg leading-relaxed">
          {tr.subheading}
        </p>
      </div>
    </div>
  </section>

  <!-- Letter Content -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <div
        class="relative bg-white border border-gray-100 rounded-3xl shadow-lg shadow-gray-100/50 overflow-hidden"
      >
        <div class="h-2 bg-primary"></div>

        <div class="p-8 md:p-14">
          <div class="mb-8">
            <svg
              class="w-12 h-12 text-primary/20"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
              ></path>
            </svg>
          </div>

          <div class="space-y-8 text-text-light leading-[1.9] text-lg">
            {tr.paragraphs.map((para) => <p>{para}</p>)}
            {
              tr.closing && (
                <p>
                  {tr.closing}
                  {tr.closingSalute && (
                    <>
                      <br />
                      {tr.closingSalute}
                    </>
                  )}
                </p>
              )
            }
          </div>

          <div class="flex items-center justify-center gap-4 my-12">
            <div
              class="flex-1 h-px bg-gradient-to-r from-transparent to-gray-200"
            >
            </div>
            <div
              class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0"
            >
              <svg
                class="w-5 h-5 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                ></path>
              </svg>
            </div>
            <div
              class="flex-1 h-px bg-gradient-to-l from-transparent to-gray-200"
            >
            </div>
          </div>

          <div class="flex justify-center">
            <div class="bg-secondary rounded-2xl p-6 inline-flex items-start gap-4">
              <div
                class="w-14 h-14 rounded-xl bg-primary flex items-center justify-center shrink-0"
              >
                <svg
                  class="w-7 h-7 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  ></path>
                </svg>
              </div>
              <div>
                <p class="text-text-light text-sm mb-1">{tr.signatureOrg}</p>
                <p class="font-semibold text-text text-lg">{tr.signatureName}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div
        class="w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center mx-auto mb-6"
      >
        <svg
          class="w-8 h-8 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
          ></path>
        </svg>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        {tr.ctaTitle}
      </h2>
      <p class="text-white/80 leading-relaxed max-w-2xl mx-auto mb-8">
        {tr.ctaBody}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={getRelativeLocaleUrl(lang, '/services')}
          class="px-8 py-4 bg-white text-primary rounded-xl font-medium hover:bg-gray-50 transition-colors shadow-lg"
        >
          {tr.ctaServices}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, '/exam')}
          class="px-8 py-4 bg-white/10 text-white border border-white/20 rounded-xl font-medium hover:bg-white/20 transition-colors"
        >
          {tr.ctaTraining}
        </a>
      </div>
    </div>
  </section>
</Layout>
