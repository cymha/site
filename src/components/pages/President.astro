---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { type Locale, t } from '../../i18n'
import Layout from '../../layouts/Layout.astro'

export interface Props {
  lang: Locale
}

const { lang } = Astro.props
const tr = t(lang).president
---

<Layout lang={lang} title={tr.title} description={tr.description}>
  <!-- Hero -->
  <section class="bg-primary-light relative overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <svg
        class="h-full w-full"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
      >
        <defs>
          <pattern
            id="dots"
            x="0"
            y="0"
            width="20"
            height="20"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="2" cy="2" r="1" fill="#2a7a6e" opacity="0.15"></circle>
          </pattern>
        </defs>
        <rect width="100" height="100" fill="url(#dots)"></rect>
      </svg>
    </div>
    <div class="relative mx-auto max-w-6xl px-6 py-20 md:py-28">
      <div class="max-w-2xl">
        <span
          class="text-primary mb-3 block text-sm font-semibold tracking-wider uppercase"
          >{tr.eyebrow}</span
        >
        <h1 class="text-text mb-6 text-3xl leading-tight font-bold md:text-5xl">
          {tr.heading}
        </h1>
        <p class="text-text-light text-lg leading-relaxed">
          {tr.subheading}
        </p>
      </div>
    </div>
  </section>

  <!-- Letter Content -->
  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-3xl px-6">
      <div
        class="relative overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-lg shadow-gray-100/50"
      >
        <div class="bg-primary h-2"></div>

        <div class="p-8 md:p-14">
          <div class="mb-8">
            <svg
              class="text-primary/20 h-12 w-12"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
              ></path>
            </svg>
          </div>

          <div class="text-text-light space-y-8 text-lg leading-[1.9]">
            {tr.paragraphs.map((para) => <p>{para}</p>)}
            {
              tr.closing && (
                <p>
                  {tr.closing}
                  {tr.closingSalute && (
                    <>
                      <br />
                      {tr.closingSalute}
                    </>
                  )}
                </p>
              )
            }
          </div>

          <div class="my-12 flex items-center justify-center gap-4">
            <div
              class="h-px flex-1 bg-linear-to-r from-transparent to-gray-200"
            >
            </div>
            <div
              class="bg-primary/10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full"
            >
              <svg
                class="text-primary h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                ></path>
              </svg>
            </div>
            <div
              class="h-px flex-1 bg-linear-to-l from-transparent to-gray-200"
            >
            </div>
          </div>

          <div class="flex justify-center">
            <div
              class="bg-secondary inline-flex items-start gap-4 rounded-2xl p-6"
            >
              <div
                class="bg-primary flex h-14 w-14 shrink-0 items-center justify-center rounded-xl"
              >
                <svg
                  class="h-7 w-7 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  ></path>
                </svg>
              </div>
              <div>
                <p class="text-text-light mb-1 text-sm">{tr.signatureOrg}</p>
                <p class="text-text text-lg font-semibold">
                  {tr.signatureName}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <div
        class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10"
      >
        <svg
          class="h-8 w-8 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
          ></path>
        </svg>
      </div>
      <h2 class="mb-4 text-2xl font-bold text-white md:text-3xl">
        {tr.ctaTitle}
      </h2>
      <p class="mx-auto mb-8 max-w-2xl leading-relaxed text-white/80">
        {tr.ctaBody}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={getRelativeLocaleUrl(lang, '/services')}
          class="text-primary rounded-xl bg-white px-8 py-4 font-medium shadow-lg transition-colors hover:bg-gray-50"
        >
          {tr.ctaServices}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, '/exam')}
          class="rounded-xl border border-white/20 bg-white/10 px-8 py-4 font-medium text-white transition-colors hover:bg-white/20"
        >
          {tr.ctaTraining}
        </a>
      </div>
    </div>
  </section>
</Layout>
