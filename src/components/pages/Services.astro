---
import Layout from '../../layouts/Layout.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { type Locale, t } from '../../i18n'

export interface Props {
  lang: Locale
}

const { lang } = Astro.props
const tr = t(lang).services

const icons = [
  'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  'M13 10V3L4 14h7v7l9-11h-7z',
  'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
]
---

<Layout lang={lang} title={tr.title} description={tr.description}>
  <!-- Hero -->
  <section class="bg-primary-light py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-6">
      <span
        class="text-primary text-sm font-semibold tracking-wider uppercase mb-3 block"
        >{tr.eyebrow}</span
      >
      <h1 class="text-3xl md:text-4xl font-bold text-text mb-4">
        {tr.heading}
      </h1>
      <p class="text-text-light text-lg max-w-2xl leading-relaxed">
        {tr.intro}
      </p>
      <div
        class="mt-6 inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-xl font-semibold text-sm"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {tr.earlyTag}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="space-y-8">
        {
          tr.categories.map((cat, idx) => (
            <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
              <div class="flex items-start gap-4 mb-6">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                  <svg
                    class="w-6 h-6 text-primary"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={icons[idx]}
                    />
                  </svg>
                </div>
                <div>
                  <span class="text-primary text-xs font-semibold tracking-wider uppercase">
                    {tr.categoryLabel} {idx + 1}
                  </span>
                  <h2 class="text-xl font-bold text-text mt-1">{cat.title}</h2>
                  <p class="text-text-muted text-sm">{cat.subtitle}</p>
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-6">
                <div class="bg-secondary/50 rounded-xl p-5">
                  <h3 class="font-semibold text-text text-sm mb-3 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-amber-400" />
                    {tr.symptomsTitle}
                  </h3>
                  <ul class="space-y-2">
                    {cat.symptoms.map((s) => (
                      <li class="text-sm text-text-light flex items-start gap-2">
                        <span class="text-primary mt-1 shrink-0">-</span>
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="bg-red-50 rounded-xl p-5">
                  <h3 class="font-semibold text-text text-sm mb-3 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-red-400" />
                    {tr.effectsTitle}
                  </h3>
                  <ul class="space-y-2">
                    {cat.effects.map((e) => (
                      <li class="text-sm text-text-light flex items-start gap-2">
                        <span class="text-red-400 mt-1 shrink-0">-</span>
                        <span>{e}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- When to Seek Help -->
  <section class="py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div
        class="w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center mx-auto mb-6"
      >
        <svg
          class="w-8 h-8 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        {tr.seekHelpTitle}
      </h2>
      <p class="text-white/80 leading-relaxed max-w-2xl mx-auto">
        {tr.seekHelpBody}
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-text mb-8">{tr.ctaTitle}</h2>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={getRelativeLocaleUrl(lang, '/services')}
          class="px-8 py-4 bg-white text-primary border-2 border-primary/20 rounded-xl font-medium hover:bg-primary-light transition-colors"
        >
          {tr.ctaTreatment}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, '/exam')}
          class="px-8 py-4 bg-secondary text-text rounded-xl font-medium hover:bg-gray-200 transition-colors"
        >
          {tr.ctaWorkshop}
        </a>
      </div>
    </div>
  </section>
</Layout>
