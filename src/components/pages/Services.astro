---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { type Locale, t } from '../../i18n'
import Layout from '../../layouts/Layout.astro'

export interface Props {
  lang: Locale
}

const { lang } = Astro.props
const tr = t(lang).services

const icons = [
  'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  'M13 10V3L4 14h7v7l9-11h-7z',
  'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
]
---

<Layout lang={lang} title={tr.title} description={tr.description}>
  <!-- Hero -->
  <section class="bg-primary-light py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <span
        class="text-primary mb-3 block text-sm font-semibold tracking-wider uppercase"
        >{tr.eyebrow}</span
      >
      <h1 class="text-text mb-4 text-3xl font-bold md:text-4xl">
        {tr.heading}
      </h1>
      <p class="text-text-light max-w-2xl text-lg leading-relaxed">
        {tr.intro}
      </p>
      <div
        class="bg-primary mt-6 inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold text-white"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {tr.earlyTag}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="space-y-8">
        {
          tr.categories.map((cat, idx) => (
            <div class="rounded-2xl border border-gray-100 bg-white p-8 transition-shadow hover:shadow-lg">
              <div class="mb-6 flex items-start gap-4">
                <div class="bg-primary/10 flex h-12 w-12 shrink-0 items-center justify-center rounded-xl">
                  <svg
                    class="text-primary h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={icons[idx]}
                    />
                  </svg>
                </div>
                <div>
                  <span class="text-primary text-xs font-semibold tracking-wider uppercase">
                    {tr.categoryLabel} {idx + 1}
                  </span>
                  <h2 class="text-text mt-1 text-xl font-bold">{cat.title}</h2>
                  <p class="text-text-muted text-sm">{cat.subtitle}</p>
                </div>
              </div>

              <div class="grid gap-6 md:grid-cols-2">
                <div class="bg-secondary/50 rounded-xl p-5">
                  <h3 class="text-text mb-3 flex items-center gap-2 text-sm font-semibold">
                    <span class="h-2 w-2 rounded-full bg-amber-400" />
                    {tr.symptomsTitle}
                  </h3>
                  <ul class="space-y-2">
                    {cat.symptoms.map((s) => (
                      <li class="text-text-light flex items-start gap-2 text-sm">
                        <span class="text-primary mt-1 shrink-0">-</span>
                        <span>{s}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="rounded-xl bg-red-50 p-5">
                  <h3 class="text-text mb-3 flex items-center gap-2 text-sm font-semibold">
                    <span class="h-2 w-2 rounded-full bg-red-400" />
                    {tr.effectsTitle}
                  </h3>
                  <ul class="space-y-2">
                    {cat.effects.map((e) => (
                      <li class="text-text-light flex items-start gap-2 text-sm">
                        <span class="mt-1 shrink-0 text-red-400">-</span>
                        <span>{e}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- When to Seek Help -->
  <section class="bg-primary py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <div
        class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10"
      >
        <svg
          class="h-8 w-8 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
      </div>
      <h2 class="mb-4 text-2xl font-bold text-white md:text-3xl">
        {tr.seekHelpTitle}
      </h2>
      <p class="mx-auto max-w-2xl leading-relaxed text-white/80">
        {tr.seekHelpBody}
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="text-text mb-8 text-2xl font-bold">{tr.ctaTitle}</h2>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={getRelativeLocaleUrl(lang, '/services')}
          class="text-primary border-primary/20 hover:bg-primary-light rounded-xl border-2 bg-white px-8 py-4 font-medium transition-colors"
        >
          {tr.ctaTreatment}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, '/exam')}
          class="bg-secondary text-text rounded-xl px-8 py-4 font-medium transition-colors hover:bg-gray-200"
        >
          {tr.ctaWorkshop}
        </a>
      </div>
    </div>
  </section>
</Layout>
